# ── Stellar Network ───────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# ── Contract Addresses (set after deployment) ─────────────────
FACTORY_CONTRACT_ADDRESS=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
TREASURY_ADDRESS=

# ── Oracle Keypair (keep secret — use a secrets manager in prod) ─
ORACLE_PRIVATE_KEY=SBAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
ORACLE_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4

# ── Admin ─────────────────────────────────────────────────────
ADMIN_JWT_SECRET=your-admin-jwt-secret-change-in-production
ADMIN_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
ADMIN_PRIVATE_KEY=SBAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://bankerchanger:bankerchanger@localhost:5432/bankerchanger
# Connection pooling: a single shared pool is reused across services
# instead of each service opening its own connections.
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
# How often pool metrics (total/idle/waiting connections) are logged.
DB_POOL_METRICS_INTERVAL_MS=15000

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ───────────────────────────────────────────────────────
PORT=3001
# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/stellarfox

# Stellar
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# ── Email ─────────────────────────────────────────────────────
# Provider: smtp | sendgrid
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@bankerchanger.app
# Required when EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.xxxx
APP_NAME=BANKERCHANGER
APP_BASE_URL=http://localhost:3001

# ── Ingress / TLS ─────────────────────────────────────────────
# Hostname the Kubernetes Ingress routes external traffic to.
INGRESS_HOST=api.bankerchanger.app
# Name of the TLS secret holding the certificate/key pair used for
# SSL termination at the ingress layer. When cert-manager is used,
# this secret is populated automatically from the referenced issuer.
INGRESS_TLS_SECRET_NAME=bankerchanger-tls
# cert-manager ClusterIssuer used to issue/renew the ingress certificate.
INGRESS_CERT_MANAGER_ISSUER=letsencrypt-prod
# Ingress class / controller that serves the ingress resource.
INGRESS_CLASS_NAME=nginx
# ── Kubernetes ConfigMap / Secret integration ─────────────────
# Non-sensitive configuration is supplied by the `bankerchanger-config`
# ConfigMap (see k8s/configmap.yaml) and injected via `envFrom`. Sensitive
# values are supplied by the `bankerchanger-secrets` Secret (see
# k8s/secret.yaml) and injected via `envFrom`/`valueFrom`. The variables
# below let the app consume versioned Secret files so credentials can be
# rotated without a redeploy.
#
# Directory where the Secret is mounted as files. When set, the config
# loader re-reads these files on change (rotation) and overlays them on
# top of the environment, so a rotated Secret takes effect without a
# restart. Leave empty to rely on env vars only (local development).
CONFIG_SECRET_DIR=/etc/bankerchanger/secrets
# How often (ms) the loader polls the mounted Secret directory for
# changes. Kubernetes updates mounted Secret files in place, so polling
# picks up rotated values. Set to 0 to disable polling.
CONFIG_RELOAD_INTERVAL_MS=30000
# Name of the ConfigMap backing non-sensitive configuration. Used for
# logging/observability so operators can trace which ConfigMap version
# is active.
CONFIG_MAP_NAME=bankerchanger-config
# Name of the Secret backing sensitive configuration.
CONFIG_SECRET_NAME=bankerchanger-secrets
# Logging
LOG_LEVEL=info
LOG_AGGREGATION_ENABLED=true
LOG_FORWARD_URL=
LOG_FORWARD_TOKEN=

# Load Testing (k6)
# Base URL the k6 load test scenarios target.
LOAD_TEST_BASE_URL=http://localhost:3000
# Virtual users and duration used by the default load test run.
LOAD_TEST_VUS=50
LOAD_TEST_DURATION=30s
