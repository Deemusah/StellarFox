      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "bankerchanger-prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m]))\n  /\nclamp_min(sum(rate(http_requests_total[5m])), 0.001)",
          "legendFormat": "error rate",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "5xx Error Rate (5m)",
      "type": "stat"
    },
